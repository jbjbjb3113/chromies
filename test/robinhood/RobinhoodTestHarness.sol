pragma solidity ^0.8.24;

import {IChromaStorage} from "../../contracts/IChromaStorage.sol";
import {ChromaRenderer} from "../../contracts/ChromaRenderer.sol";

/// @notice Minimal Robinhood Chain testnet dry-run fixture.
/// @dev Wires an UNMODIFIED `ChromaRenderer` (see contracts/ChromaRenderer.sol) to a
/// fresh, isolated `ChromaStorage` seeded with an existing Sepolia test fixture
/// (art-pipeline/output/test-reveal.json "reveal" payload, tokenId 1). No canvas or
/// Chroma token is wired, so `tokenURI` output depends only on the storage + palette
/// data + renderer bytecode — the same bytecode deployed on Sepolia — making this a
/// fair byte-for-byte parity target across chains. Not used by any mainnet-targeted
/// code path; deploy-only test/dry-run fixture.
contract RobinhoodTestHarness {
    uint256 public constant SAMPLE_TOKEN_ID = 1;

    /// @dev art-pipeline/output/test-reveal.json -> reveal.traitsHex (32 bytes).
    bytes public constant SAMPLE_TRAITS_HEX =
        hex"0004010001000000000101000002010301000000000000000000000000000000";

    /// @dev art-pipeline/output/test-reveal.json -> reveal.pixelsHex (2048 bytes, nibble-packed).
    bytes public constant SAMPLE_PIXELS_HEX =
        hex"";

    ChromaRenderer public immutable renderer;
    IChromaStorage public immutable chromaStorage;
    bool public seeded;

    constructor(address storageAddress, address rendererAddress) {
        chromaStorage = IChromaStorage(storageAddress);
        renderer = ChromaRenderer(rendererAddress);
    }

    /// @dev Storage's `writer` must be set to this harness before calling. Idempotent
    /// against re-broadcast (ChromaStorage.writeTokenData reverts TokenAlreadyWritten
    /// on a second call for the same tokenId — `seeded` short-circuits that here).
    function seed() external {
        if (seeded) return;
        seeded = true;
        chromaStorage.writeTokenData(SAMPLE_TOKEN_ID, SAMPLE_PIXELS_HEX, SAMPLE_TRAITS_HEX);
    }

    /// @notice Passthrough to the wired (unmodified) ChromaRenderer for the seeded sample token.
    function tokenURI(uint256 tokenId) external view returns (string memory) {
        return renderer.tokenURI(tokenId);
    }
}
