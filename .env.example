SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Or Alchemy Sepolia: https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
ALCHEMY_MAINNET_KEY=your-alchemy-key
ETHERSCAN_API_KEY=your-etherscan-api-key

# Robinhood Chain testnet dry-run (see script/robinhood/, test/robinhood/) — chain id 46630.
# Prefer an Alchemy "Robinhood Chain Testnet" app; falls back to the public RPC below
# per docs.robinhood.com/chain/connecting if no Alchemy key is configured.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Or Alchemy: https://robinhood-testnet.g.alchemy.com/v2/your-alchemy-key
# Fund the deployer (same PRIVATE_KEY as Sepolia) at https://faucet.testnet.chain.robinhood.com
# before running any script/robinhood/*.s.sol with --broadcast.
# Robinhood Chain MAINNET (chain id 4663) — used by foundry.toml's robinhood_mainnet RPC
# alias. ChromiesCommemorative is already deployed and seeded here; this var is the hard
# gate before mintOpen is ever flipped (see foundry.toml comment).
ALCHEMY_RH_MAINNET_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-alchemy-key
ROBINHOOD_CHROMA_STORAGE_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_PALETTE_DATA_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_RENDERER_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_HARNESS_ADDRESS=0x0000000000000000000000000000000000000000

CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHROMA_STORAGE_ADDRESS=0x0000000000000000000000000000000000000000
CHROMA_ADDRESS=0x0000000000000000000000000000000000000000
CANVAS_ADDRESS=0x0000000000000000000000000000000000000000
CHROMA_RENDERER_ADDRESS=0x0000000000000000000000000000000000000000
CHROMA_PALETTE_DATA_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000

PONDER_RPC_URL=http://127.0.0.1:8545
PONDER_CHAIN_ID=31337
CHROMA_START_BLOCK=0
PONDER_SQL_URL=http://127.0.0.1:42069/sql

API_PORT=8080

# Frontend (Vite) — copy to .env.local for dev
# VITE_ALCHEMY_KEY=your-alchemy-key
# Optional — only needed if the VITE_ALCHEMY_KEY app above does NOT have the Robinhood
# Chain network enabled. If set, takes priority over VITE_ALCHEMY_KEY for the
# /launch-edition mainnet transport (src/lib/wagmi.js); always falls back to the public
# RPC (rpc.mainnet.chain.robinhood.com) if this and VITE_ALCHEMY_KEY are both unset/fail.
# VITE_ALCHEMY_RH_MAINNET_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-alchemy-key
# VITE_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_HOST=http://127.0.0.1:11434
# VITE_CHAT_COMPLETIONS_URL=https://your-backend.example/v1/chat/completions
# VITE_TTS_PROXY_URL=https://normies-tts-proxy.your-subdomain.workers.dev
